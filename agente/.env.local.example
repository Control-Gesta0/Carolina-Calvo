# === Kommo (conta 33595135) ===
KOMMO_DOMAIN=https://advogadacarolinacalvo.kommo.com
# Token de LONGA DURAÇÃO (JWT, começa com "eyJ")
KOMMO_TOKEN=
KOMMO_ACCOUNT_ID=33595135
# Salesbot de TEXTO LIVRE (1 bloco "Enviar mensagem" com o campo IA - Resposta (Anna))
KOMMO_BOT_ID=

# === LLM (chave comercial do escritório; limite US$ 20/mês na OpenAI) ===
OPENAI_API_KEY=
LLM_MODEL=gpt-5.4-mini-2026-03-17
VISION_MODEL=gpt-5.4-mini-2026-03-17
STT_MODEL=gpt-4o-mini-transcribe

# === Upstash Redis (OBRIGATÓRIO: histórico, estado, fila do relógio) ===
# Database compartilhada com outros agentes: o REDIS_PREFIX separa as chaves. Não troque.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
REDIS_PREFIX=anna-cc:

# === Google Agenda (tutoriais/01-google-agenda.mp4) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# e-mail da agenda das reuniões (ou "primary" = agenda principal da conta que autorizou)
GOOGLE_CALENDAR_ID=primary

# === Operação ===
WEBHOOK_SECRET=            # openssl rand -hex 24 — NOVO por cliente
CRON_SECRET=               # openssl rand -hex 24 — o QStash manda no Authorization do /api/tick
CLIENT_NAME="Carolina Calvo · Anna"
DEBOUNCE_SECONDS=10
# Gate: a Anna só fala com lead que tem esta tag (rampagem: 1 contato nosso → 10 leads → todos)
GATE_TAG=ia
HUMAN_TAG=atendimento-humano
# true = lead novo de formulário de superendividamento já recebe a tag e o primeiro contato (só depois da rampagem)
AUTO_GATE_FORM_LEADS=false
# true = régua pós-proposta (24h depois de Cliente decisão). Só depois de desligar a automação antiga do Kommo
POS_PROPOSTA_ATIVO=false
# Leads de teste que podem mandar "reset"
TEST_LEAD_IDS=

# === Só para scripts locais ===
DEPLOY_URL=
# QStash (relógio): só o scripts/criar-relogio.ts usa. A conta é compartilhada com outros clientes
QSTASH_URL=https://qstash-eu-central-1.upstash.io
QSTASH_TOKEN=
